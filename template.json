{
  "manifest_version": 3,
  "name": "Meet Mate",
  "version": "1.0",
  "description": "Your personal meeting scheduler",
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "frontend/logo.png"
  },
  "permissions": [
    "activeTab", 
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "${GOOGLE_OAUTH_TOKEN}.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly",
      "https://www.googleapis.com/auth/calendar.events"
    ]
  }
}